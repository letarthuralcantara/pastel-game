; Engine configuration file.
; Pastelaria do Bairro — browser game
config_version=5

[application]

boot_splash/image="res://assets/pastel/pastel_base.png"
boot_splash/show_image=false
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.149, 0.098, 0.071, 1)
config/name="Pastelaria do Bairro"
config/description="Um jogo brasileiro de montar pastéis no navegador."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/pastel/pastel_base.png"

[autoload]

TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"
ManusFontTheme="*res://autoload/manus_font_theme.gd"
SaveStore="*res://autoload/save_store.gd"
I18n="*res://autoload/i18n.gd"
TuningStore="*res://autoload/tuning_store.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[editor]
import/use_multiple_threads=false
